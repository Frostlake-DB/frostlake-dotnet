<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The engine's testkit corpus replayed through this provider: a console runner, not a test
    project. The test project replays the corpus through it when FL_CORPUS is set; the README
    says how to run it on its own.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Frostlake.Data.Testkit</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Frostlake.Data/Frostlake.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Frostlake.Data.Tests" />
  </ItemGroup>

</Project>
