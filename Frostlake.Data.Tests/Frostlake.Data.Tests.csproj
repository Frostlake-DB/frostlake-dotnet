<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.6.6" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.6" />
    <PackageReference Include="Dapper" Version="2.1.28" />
    <!-- xunit 2 has no runtime skip: this adds one, for checks an older engine cannot answer. -->
    <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Frostlake.Data/Frostlake.Data.csproj" />
    <!-- The testkit corpus runner, which TestkitCorpusTests calls in-process when FL_CORPUS is set. -->
    <ProjectReference Include="../Frostlake.Data.Testkit/Frostlake.Data.Testkit.csproj" />
  </ItemGroup>

</Project>
